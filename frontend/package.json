{
  "name": "osrs-spawn-map-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:spawn-data && tsc --noEmit && vite build",
    "check:spawn-data": "cd .. && uv run python -m osrs_spawn_scraper.check_spawns data/spawn_items.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:check": "oxlint -c ../.oxlintrc.json .",
    "lint:write": "oxlint -c ../.oxlintrc.json --fix .",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt ."
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "ajv": "^8.17.1",
    "oxfmt": "^0.51.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
